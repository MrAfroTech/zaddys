# --- Online ordering (see README "Online ordering") ---------------------------
# Server-only. Set these in Vercel project settings; never commit real values.
#
# All restaurants share ONE Supabase project (salesMastery) and one set of
# tables (clients, menus, menu_items, client_orders, ...). Never create a new
# Supabase project for a client — onboard them with ordering_onboard_client.

# Shared Supabase project (salesMastery).
SUPABASE_URL=https://smqwemfobrqxnpcooigd.supabase.co
# Service role key: used only by /api on the server. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Which establishment this deployment serves (clients.slug).
# Per-client settings — $Cashtag, online ordering on/off — live in the clients table.
CLIENT_SLUG=zaddys

# Long random string used to sign customer order-status links
# (e.g. `openssl rand -base64 48`). Changing it invalidates existing links.
ORDER_LINK_SECRET=

# Canonical origin for order-status links in staff payment messages,
# e.g. https://zaddys-iota.vercel.app. Falls back to the request host.
SITE_URL=

# --- Browser (build-time, public) ------------------------------------------------
# Shared project URL + anon key for staff sign-in only (existing Supabase Auth).
# RLS limits what the anon key can see: active clients' public menus only.
VITE_SUPABASE_URL=https://smqwemfobrqxnpcooigd.supabase.co
VITE_SUPABASE_ANON_KEY=
# Shows "Order online" in the site navigation when "true".
VITE_ONLINE_ORDERING=false
